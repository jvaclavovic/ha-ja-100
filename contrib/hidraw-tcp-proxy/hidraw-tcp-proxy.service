[Unit]
Description=Jablotron JA-100 hidraw to TCP proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Restrict clients with --allow (comma-separated addresses/networks), e.g.:
# ExecStart=/usr/bin/python3 /opt/hidraw-tcp-proxy/hidraw_tcp_proxy.py --port 8765 --allow 10.0.0.6,10.0.0.21
ExecStart=/usr/bin/python3 /opt/hidraw-tcp-proxy/hidraw_tcp_proxy.py --port 8765
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
